1124:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   * @brief  Sends an amount of data in blocking mode.
1125:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   * @note   When UART parity is not enabled (PCE = 0), and Word Length is configured to 9 bits (M1-
1126:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   *         the sent data is handled as a set of u16. In this case, Size must indicate the number
1127:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   *         of u16 provided through pData.
1128:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   * @param  huart Pointer to a UART_HandleTypeDef structure that contains
1129:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   *               the configuration information for the specified UART module.
1130:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   * @param  pData Pointer to data buffer (u8 or u16 data elements).
1131:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   * @param  Size  Amount of data elements (u8 or u16) to be sent
1132:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   * @param  Timeout Timeout duration
1133:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   * @retval HAL status
1134:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   */
1135:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c **** HAL_StatusTypeDef HAL_UART_Transmit(UART_HandleTypeDef *huart, const uint8_t *pData, uint16_t Size,
1136:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c **** {
1137:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   const uint8_t  *pdata8bits;
1138:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   const uint16_t *pdata16bits;
1139:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   uint32_t tickstart = 0U;
1140:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c **** 
1141:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   /* Check that a Tx process is not already ongoing */
1142:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   if (huart->gState == HAL_UART_STATE_READY)
1143:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****   {
1144:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****     if ((pData == NULL) || (Size == 0U))
1145:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****     {
1146:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c ****       return  HAL_ERROR;
