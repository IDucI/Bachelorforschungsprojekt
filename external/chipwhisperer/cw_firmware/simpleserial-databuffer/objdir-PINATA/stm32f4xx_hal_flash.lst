   1:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** /**
   2:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   ******************************************************************************
   3:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   * @file    stm32f4xx_hal_flash.c
   4:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   * @author  MCD Application Team
   5:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   * @brief   FLASH HAL module driver.
   6:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   *          This file provides firmware functions to manage the following
   7:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   *          functionalities of the internal FLASH memory:
   8:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   *           + Program operations functions
   9:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   *           + Memory Control functions
  10:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   *           + Peripheral Errors functions
  11:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   *
  12:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   @verbatim
  13:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   ==============================================================================
  14:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****                         ##### FLASH peripheral features #####
  15:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   ==============================================================================
  16:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** 
  17:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   [..] The Flash memory interface manages CPU AHB I-Code and D-Code accesses
  18:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****        to the Flash memory. It implements the erase and program Flash memory operations
  19:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****        and the read and write protection mechanisms.
  20:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** 
  21:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   [..] The Flash memory interface accelerates code execution with a system of instruction
  22:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****        prefetch and cache lines.
  23:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** 
  24:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   [..] The FLASH main features are:
  25:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       (+) Flash memory read operations
  26:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       (+) Flash memory program/erase operations
  27:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       (+) Read / write protections
  28:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       (+) Prefetch on I-Code
  29:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       (+) 64 cache lines of 128 bits on I-Code
  30:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       (+) 8 cache lines of 128 bits on D-Code
  31:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** 
  32:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** 
  33:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****                      ##### How to use this driver #####
  34:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   ==============================================================================
  35:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****     [..]
  36:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       This driver provides functions and macros to configure and program the FLASH
  37:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       memory of all STM32F4xx devices.
  38:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** 
  39:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       (#) FLASH Memory IO Programming functions:
  40:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****            (++) Lock and Unlock the FLASH interface using HAL_FLASH_Unlock() and
  41:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****                 HAL_FLASH_Lock() functions
  42:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****            (++) Program functions: byte, half word, word and double word
  43:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****            (++) There Two modes of programming :
  44:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****             (+++) Polling mode using HAL_FLASH_Program() function
  45:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****             (+++) Interrupt mode using HAL_FLASH_Program_IT() function
  46:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** 
  47:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       (#) Interrupts and flags management functions :
  48:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****            (++) Handle FLASH interrupts by calling HAL_FLASH_IRQHandler()
  49:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****            (++) Wait for last FLASH operation according to its status
  50:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****            (++) Get error flag status by calling HAL_SetErrorCode()
  51:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** 
  52:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****     [..]
  53:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       In addition to these functions, this driver includes a set of macros allowing
  54:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****       to handle the following operations:
  55:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****        (+) Set the latency
  56:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****        (+) Enable/Disable the prefetch buffer
  57:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****        (+) Enable/Disable the Instruction cache and the Data cache
  58:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****        (+) Reset the Instruction cache and the Data cache
  59:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****        (+) Enable/Disable the FLASH interrupts
  60:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****        (+) Monitor the FLASH flags status
  61:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c **** 
  62:../hal/chipwhisperer-fw-extra/pinata/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c ****   @endverbatim
