 159:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** 
 160:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** /**
 161:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   * @brief  Setup the microcontroller system
 162:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   *         Initialize the FPU setting, vector table location and External memory 
 163:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   *         configuration.
 164:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   * @param  None
 165:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   * @retval None
 166:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   */
 167:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** void SystemInit(void)
 168:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** {
  27              		.loc 1 168 1 view -0
  28              		.cfi_startproc
  29              		@ args = 0, pretend = 0, frame = 0
  30              		@ frame_needed = 0, uses_anonymous_args = 0
  31              		@ link register save eliminated.
 169:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   /* FPU settings ------------------------------------------------------------*/
 170:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   #if (__FPU_PRESENT == 1) && (__FPU_USED == 1)
 171:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****     SCB->CPACR |= ((3UL << 10*2)|(3UL << 11*2));  /* set CP10 and CP11 Full Access */
 172:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   #endif
 173:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** 
 174:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #if defined (DATA_IN_ExtSRAM) || defined (DATA_IN_ExtSDRAM)
 175:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****   SystemInit_ExtMemCtl(); 
 176:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #endif /* DATA_IN_ExtSRAM || DATA_IN_ExtSDRAM */
 177:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** 
