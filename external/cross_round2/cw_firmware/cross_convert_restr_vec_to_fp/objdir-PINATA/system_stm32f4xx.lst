  89:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** /* Note: Following vector table addresses must be defined in line with linker
  90:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****          configuration. */
  91:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** /*!< Uncomment the following line if you need to relocate the vector table
  92:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****      anywhere in Flash or Sram, else the vector table is kept at the automatic
  93:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****      remap of boot address selected */
  94:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** // #define USER_VECT_TAB_ADDRESS 
  95:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** 
  96:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #if defined(USER_VECT_TAB_ADDRESS)
  97:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** /*!< Uncomment the following line if you need to relocate your vector Table
  98:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****      in Sram else user remap will be done in Flash. */
  99:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** /* #define VECT_TAB_SRAM */
 100:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #if defined(VECT_TAB_SRAM)
 101:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #define VECT_TAB_BASE_ADDRESS   SRAM_BASE       /*!< Vector Table base address field.
 102:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****                                                      This value must be a multiple of 0x200. */
 103:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #else
 104:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #define VECT_TAB_BASE_ADDRESS   FLASH_BASE      /*!< Vector Table base address field.
 105:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****                                                      This value must be a multiple of 0x200. */
 106:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #endif /* VECT_TAB_SRAM */
 107:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #if !defined(VECT_TAB_OFFSET)
 108:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #define VECT_TAB_OFFSET         0x00000000U     /*!< Vector Table offset field.
 109:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****                                                      This value must be a multiple of 0x200. */
 110:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #endif /* VECT_TAB_OFFSET */
 111:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** #endif /* USER_VECT_TAB_ADDRESS */
