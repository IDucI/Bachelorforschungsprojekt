 230:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****       SystemCoreClock = HSI_VALUE;
 231:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****       break;
 232:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****     case 0x04:  /* HSE used as system clock source */
 233:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****       SystemCoreClock = HSE_VALUE;
 234:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****       break;
 235:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****     case 0x08:  /* PLL used as system clock source */
 236:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c **** 
 237:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****       /* PLL_VCO = (HSE_VALUE or HSI_VALUE / PLL_M) * PLL_N
 238:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****          SYSCLK = PLL_VCO / PLL_P
 239:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****          */    
 240:../hal/chipwhisperer-fw-extra/pinata/Src/system_stm32f4xx.c ****       pllsource = (RCC->PLLCFGR & RCC_PLLCFGR_PLLSRC) >> 22;
