1534:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/core_cm4.h ****   \param[in] value  Value of register. This parameter is interpreted as an uint32_t type.
1535:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/core_cm4.h ****   \return           Masked and shifted bit field value.
1536:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/core_cm4.h **** */
1537:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/core_cm4.h **** #define _FLD2VAL(field, value)    (((uint32_t)(value) & field ## _Msk) >> field ## _Pos)
