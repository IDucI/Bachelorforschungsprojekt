1528:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/core_cm4.h **** */
1529:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/core_cm4.h **** #define _VAL2FLD(field, value)    (((uint32_t)(value) << field ## _Pos) & field ## _Msk)
1530:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/core_cm4.h **** 
1531:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/core_cm4.h **** /**
1532:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/core_cm4.h ****   \brief     Mask and shift a register value to extract a bit filed value.
