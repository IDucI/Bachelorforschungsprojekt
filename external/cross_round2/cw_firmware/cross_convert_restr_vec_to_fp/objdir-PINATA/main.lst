 166:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** /* e*chall_1 + u_prime*/
 167:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** static inline
 168:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** void fp_vec_by_restr_vec_scaled(FP_ELEM res[N],
 169:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                 const FZ_ELEM e[N],
 170:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                 const FP_ELEM chall_1,
 171:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                 const FP_ELEM u_prime[N]){
 172:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     for(int i = 0; i < N; i++){
