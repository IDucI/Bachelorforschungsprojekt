 181:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                  const FP_ELEM synd[N-K],
 182:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                  const FP_ELEM chall_1,
 183:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                  const FP_ELEM s[N-K]){
 184:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     for(int j = 0; j < N-K; j++){
 185:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****         FP_ELEM tmp = FPRED_DOUBLE( (FP_DOUBLEPREC) s[j] * (FP_DOUBLEPREC) chall_1);
