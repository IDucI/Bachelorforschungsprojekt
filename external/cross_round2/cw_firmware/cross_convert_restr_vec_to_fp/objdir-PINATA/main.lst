 111:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** /* Computes the product e*H of an n-element restricted vector by a (n-k)*n
 112:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****  * FP H is in systematic form. Only the non systematic portion of H =[V I],
 113:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****  * V, is provided, transposed, hence linearized by columns so that syndrome
 114:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****  * computation is vectorizable. */
 115:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
 116:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** static
 117:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** void restr_vec_by_fp_matrix(FP_ELEM res[N-K],
 118:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                             FZ_ELEM e[N],
 119:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                             FP_ELEM V_tr[K][N-K]){
 120:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     for (int i = K ;i < N; i++){
 121:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****        res[i-K] = RESTR_TO_VAL(e[i]);
 122:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     }
 123:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     for(int i = 0; i < K; i++){
 124:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****        for(int j = 0; j < N-K; j++){
 125:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****            res[j] = FPRED_DOUBLE( (FP_DOUBLEPREC) res[j] +
 126:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                   (FP_DOUBLEPREC) RESTR_TO_VAL(e[i]) *
 127:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                   (FP_DOUBLEPREC) V_tr[i][j]);
 128:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****        }
 129:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     }
 130:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** }
 131:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
 132:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** static
 133:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** void fp_vec_by_fp_matrix(FP_ELEM res[N-K],
 134:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                          FP_ELEM e[N],
 135:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                          FP_ELEM V_tr[K][N-K]){
 136:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     memcpy(res,e+K,(N-K)*sizeof(FP_ELEM));
 137:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     for(int i = 0; i < K; i++){
 138:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****        for(int j = 0; j < N-K; j++){
 139:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****            res[j] = FPRED_DOUBLE( (FP_DOUBLEPREC) res[j] +
 140:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                   (FP_DOUBLEPREC) e[i] *
 141:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                   (FP_DOUBLEPREC) V_tr[i][j]);
 142:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****        }
 143:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     }
 144:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** }
 145:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
 146:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** static inline
 147:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** void fp_vec_by_fp_vec_pointwise(FP_ELEM res[N],
 148:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                 const FP_ELEM in1[N],
 149:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****                                 const FP_ELEM in2[N]){
 150:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     for(int i = 0; i < N; i++){
