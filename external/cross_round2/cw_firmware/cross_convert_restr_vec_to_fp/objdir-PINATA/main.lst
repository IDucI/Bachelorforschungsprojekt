  32:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #pragma once
  33:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  34:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #include <stdlib.h>
  35:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #include <string.h>
  36:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  37:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #include "csprng_hash.h"
  38:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #include "parameters.h"
  39:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #include "restr_arith.h"
  40:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  41:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define NUM_BITS_P (BITS_TO_REPRESENT(P))
  42:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  43:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #if defined(RSDP)
  44:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define FPRED_SINGLE(x) (((x) & 0x7F) + ((x) >> 7))
  45:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define FPRED_DOUBLE(x) FPRED_SINGLE(FPRED_SINGLE(x))
  46:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define FPRED_OPPOSITE(x) ((x) ^ 0x7F)
  47:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define FP_DOUBLE_ZERO_NORM(x) (((x) + (((x) + 1) >> 7)) & 0x7F)
  48:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define RESTR_TO_VAL(x) ( (FP_ELEM) (RESTR_G_TABLE >> (8*(uint64_t)(x))) )
  49:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  50:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #elif defined(RSDPG)
  51:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** /* Reduction modulo P=509 as shown in:
  52:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****  * Hacker's Delight, Second Edition, Chapter 10, Figure 10-4
  53:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****  * Works for integers in the range [0,4294967295] i.e. all uint32_t */
  54:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define FPRED_SINGLE(x) (((x) - (((uint64_t)(x) * 2160140723) >> 40) * P))
  55:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define FPRED_DOUBLE(x) (FPRED_SINGLE(x))
  56:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define FPRED_OPPOSITE(x) (FPRED_SINGLE(P - (x)))
  57:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** /* no redundant zero notation in F_509 */
  58:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define FP_DOUBLE_ZERO_NORM(x) (x)
  59:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  60:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** /* for i in [0,1,2,4,8,16,32,64] RESTR_G_GEN**i mod 509 yields
  61:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****  * [1, 16, 256, 384, 355, 302, 93, 505]
  62:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****  * the following is a precomputed-squares S&M, to be optimized into muxed
  63:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****  * register stored tables */
  64:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  65:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define RESTR_G_GEN_1  ((FP_ELEM)RESTR_G_GEN)
  66:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define RESTR_G_GEN_2  ((FP_ELEM) 256)
  67:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define RESTR_G_GEN_4  ((FP_ELEM) 384)
  68:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define RESTR_G_GEN_8  ((FP_ELEM) 355)
  69:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define RESTR_G_GEN_16 ((FP_ELEM) 302)
  70:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define RESTR_G_GEN_32 ((FP_ELEM) 93)
  71:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define RESTR_G_GEN_64 ((FP_ELEM) 505)
  72:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  73:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #define FP_ELEM_CMOV(BIT,TRUE_V,FALSE_V)  ( (((FP_ELEM)0 - (BIT)) & (TRUE_V)) | (~((FP_ELEM)0 - (BI
  74:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  75:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** /* log reduction, constant time unrolled S&M w/precomputed squares.
  76:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****  * To be further optimized with muxed register-fitting tables */
  77:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** static inline
  78:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** FP_ELEM RESTR_TO_VAL(FP_ELEM x){
  79:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     uint32_t res1, res2, res3, res4;
  80:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     res1 = ( FP_ELEM_CMOV(((x >> 0) &1),RESTR_G_GEN_1 ,1)) *
  81:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****            ( FP_ELEM_CMOV(((x >> 1) &1),RESTR_G_GEN_2 ,1)) ;
  82:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     res2 = ( FP_ELEM_CMOV(((x >> 2) &1),RESTR_G_GEN_4 ,1)) *
  83:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****            ( FP_ELEM_CMOV(((x >> 3) &1),RESTR_G_GEN_8 ,1)) ;
  84:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     res3 = ( FP_ELEM_CMOV(((x >> 4) &1),RESTR_G_GEN_16,1)) *
  85:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****            ( FP_ELEM_CMOV(((x >> 5) &1),RESTR_G_GEN_32,1)) ;
  86:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     res4 =   FP_ELEM_CMOV(((x >> 6) &1),RESTR_G_GEN_64,1);
  87:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  88:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     /* Two intermediate reductions necessary:
  89:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****      *     RESTR_G_GEN_1*RESTR_G_GEN_2*RESTR_G_GEN_4*RESTR_G_GEN_8    < 2^32
  90:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****      *     RESTR_G_GEN_16*RESTR_G_GEN_32*RESTR_G_GEN_64               < 2^32 */
  91:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     return FPRED_SINGLE( FPRED_SINGLE(res1 * res2) * FPRED_SINGLE(res3 * res4) );
  92:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** }
  93:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  94:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** #endif
  95:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  96:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** 
  97:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** /* in-place normalization of redundant zero representation for syndromes*/
  98:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** static inline
  99:../../libcross/variants/Reference_Implementation/include/fp_arith.h **** void fp_dz_norm_synd(FP_ELEM v[N-K]){
 100:../../libcross/variants/Reference_Implementation/include/fp_arith.h ****     for (int i = 0; i < N-K; i++){
