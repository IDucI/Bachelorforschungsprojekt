 744:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     }
 745:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****   }
 746:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****   return (uint32_t)val;
