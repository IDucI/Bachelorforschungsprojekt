 708:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h **** {
 709:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****   if ((sat >= 1U) && (sat <= 32U))
 710:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****   {
 711:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     const int32_t max = (int32_t)((1U << (sat - 1U)) - 1U);
