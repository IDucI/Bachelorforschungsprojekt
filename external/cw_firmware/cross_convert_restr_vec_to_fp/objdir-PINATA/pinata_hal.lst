 713:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     if (val > max)
 714:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     {
 715:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****       return max;
 716:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     }
 717:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     else if (val < min)
 718:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     {
 719:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****       return min;
 720:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     }
 721:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****   }
