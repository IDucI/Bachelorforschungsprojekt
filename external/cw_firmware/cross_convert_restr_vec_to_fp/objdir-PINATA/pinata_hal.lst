 735:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****   {
 736:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     const uint32_t max = ((1U << sat) - 1U);
