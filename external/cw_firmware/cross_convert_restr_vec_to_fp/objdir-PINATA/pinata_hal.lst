 738:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     {
 739:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****       return max;
 740:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     }
 741:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     else if (val < 0)
 742:../hal/chipwhisperer-fw-extra/pinata/CMSIS/Include/cmsis_gcc.h ****     {
